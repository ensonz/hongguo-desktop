#!/usr/bin/env bash
# 提交前置检查：Rust 三目标零警告 + 忽略标签禁令 + 测试 + 前端 lint。
#
# 启用（克隆后执行一次）：
#   git config core.hooksPath .githooks
#
# Rust 侧在仓库根执行（workspace 根 manifest），--workspace 覆盖全部成员 crate。
#
# macOS 目标在本机是交叉检查：objc2-exception-helper 要 Apple 交叉 C 工具链
#（没有），而 check/clippy 不链接——用占位 CC/AR 让它的 C 编译步骤假成功即可，
# 不影响检查结果的正确性，也不影响 CI 上的真构建。
#
# hongguo-gpui 在两条 macOS 交叉里排除：gpui 依赖（gpui_media 等）的 build
# script 要 bindgen Apple 框架头，Windows 宿主没有 macOS SDK 生不出来——
# 与 Makefile lint 的排除同口径；CI 的 macOS 原生 runner 不受影响。Windows
# 宿主那条照常全量（gpui 在 Windows 编译无碍）。
# hongguo-playback 同理排除：cpal → coreaudio-sys 0.2.18 对 Apple 目标无条件
# bindgen（需 libclang + macOS SDK 头），本机生不出来；macOS 覆盖由 Mac 本机
# 与 CI 承担，Windows 宿主那条仍全量含它。
set -euo pipefail
cd "$(dirname "$0")/.."

export CC_aarch64_apple_darwin=true AR_aarch64_apple_darwin=true
export CC_x86_64_apple_darwin=true AR_x86_64_apple_darwin=true

STRICT='-D warnings -D clippy::allow_attributes'

echo '[pre-commit] cargo clippy（Windows 宿主）'
cargo clippy --workspace --all-targets -- $STRICT

echo '[pre-commit] cargo clippy（macOS aarch64 交叉）'
cargo clippy --workspace --exclude hongguo-gpui --exclude hongguo-playback --target aarch64-apple-darwin --all-targets -- $STRICT

echo '[pre-commit] cargo clippy（macOS x86_64 交叉）'
cargo clippy --workspace --exclude hongguo-gpui --exclude hongguo-playback --target x86_64-apple-darwin --all-targets -- $STRICT

echo '[pre-commit] cargo test（lib）'
cargo test --workspace --lib --quiet

echo '[pre-commit] eslint'
pnpm exec eslint . --max-warnings=0

echo '[pre-commit] 全部通过'
